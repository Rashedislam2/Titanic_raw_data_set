class_medians<-titanic%>%
group_by(Pclass)%>%
summarise(median_age=median(Age,na.rm = TRUE))
titanic<-titanic%>%
left_join(class_medians,by="Pclass")%>%
mutate(age_median_grouped=ifelse(is.na(Age),median_age,Age))%>%
select(-median_age)
miss_count<-colSums(is,na(titanic$age_median_grouped))
miss_count<-colSums(is.na(titanic$age_median_grouped))
miss_count<-colSums(is.na(age_median_grouped))
miss_count<-colSums(is.na(titanic))
miss_count
#cap fare outliers
q1<-quantile(titanic$Fare,0.25,na.rm = TRUE)
q3<-quantile(titanic$Fare,0.75,na.rm = TRUE)
IQR=q3-q1
q1_fare<-quantile(titanic$Fare,0.25,na.rm = TRUE)
q3_fare<-quantile(titanic$Fare,0.75,na.rm = TRUE)
IQR=q3_fare-q1_fare
upper_bound=q3_fare+1.5*IQR
titanic<-titanic%>%
mutate(fare_capped=ifelse(Fare>upper_bound,upper_bound,Fare))
titanic_clean<-titanic%>%
select(-Fare)
titanic_clean<-titanic_clean%>%
rename(Fare=fare_capped)
mean_age<-mean(titanic$age_median_grouped,na.rm = TRUE)
sd_age<-sd(titanic$age_median_grouped,na.rm = TRUE)
median_age<-median(titanic$age_median_grouped,na.rm = TRUE)
mean_fare <-mean(titanic$fare_capped,na.rm = TRUE)
median_fare<-median(titanic$fare_capped,na.rm = TRUE)
sd_fare<-sd(titanic$fare_capped,na.rm = TRUE)
cat("STEP 4: STATISTICAL PROFILE REPORT\n")
cat("========================================\n")
cat("VARIABLE: AGE\n")
cat("Mean  :", round(mean_age, 2), "\n")
cat("Median:", round(median_age, 2), "\n")
cat("SD    :", round(sd_age, 2), "\n")
cat("IQR   :", round(iqr_age, 2), "\n")
