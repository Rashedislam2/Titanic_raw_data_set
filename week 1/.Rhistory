#loading the data set
titanic<-read.csv("Titanic-Dataset.csv")
#checking the missing value in the data set
missing_count<-colSums(is.na(titanic))
print(missing_count)
class_medians<-titanic%>%group_by(Pclass)
View(class_medians)
View(class_medians)
class_medians<-titanic%>%
group_by(Pclass)%>%
summarise(median_age=median(Age,na.rm = TRUE))
View(class_medians)
