setwd("C:/Rashed/R programming/r git hub/mastering-statistics")
library(tidyverse)
titanic<-read.csv("Titanic-Dataset.csv")
titanic
#checking column with na
colSums(is.na(titanic))
#here age cloumn has 177 missing values
#simple median imputation
global_median_age <-median(titanic$Age,na.rm = TRUE)
titanic<-titanic %>% mutate(Age_filled_simple = ifelse(is.na(Age), global_median_age ,Age))
sum(is.na(titanic$Age_filled_simple))
class_median<-Titanic%>%group_by(Pclass)
class_median<-titanic%>%group_by(Pclass)
class_median
class_median<-titanic%>%group_by(Pclass)%>% summarise(median_age=median(Age,na.rm = TRUE))
class_median
print(class_median)
titanic<-titanic%>%
left_join(class_median,Pclass)%>%mutate(Age_filled_group=ifelse(is.na(Age),class_median,Age))
titanic<-titanic%>%
left_join(class_median,by=Pclass)%>%mutate(Age_filled_group=ifelse(is.na(Age),class_median,Age))
titanic<-titanic%>%
left_join(class_median,by= Pclass)%>%mutate(Age_filled_group=ifelse(is.na(Age),class_median,Age))
